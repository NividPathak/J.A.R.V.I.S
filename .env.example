# Copy to .env and fill in. .env and .env.* are gitignored.

JARVIS_NAME=J.A.R.V.I.S
JARVIS_USER=Nivid

# Model backend: ollama (free, local) | anthropic (paid)
JARVIS_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Router backend: llm (Phase 1) | tuned (Phase 4)
JARVIS_ROUTER=llm
JARVIS_ROUTER_MODEL=llama3.2:3b

# Location, for weather and advisories
JARVIS_LAT=
JARVIS_LON=
JARVIS_TZ=America/New_York

# Data sources
CRICKET_API_KEY=
WEATHER_API_KEY=
