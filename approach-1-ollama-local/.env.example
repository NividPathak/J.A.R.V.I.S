# ── Model Provider ─────────────────────────────────────────────────────────────
# Options: "ollama" | "anthropic"
JARVIS_PROVIDER=ollama

# ── Ollama (free, local) ────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# Recommended models by capability tier:
#   Fast     : llama3.2:3b
#   Balanced : llama3.1:8b   ← best for M4 16GB
#   Powerful : llama3.1:70b  (needs 40GB+ RAM)
OLLAMA_MODEL=llama3.2:3b

# ── Anthropic (paid, cloud) ─────────────────────────────────────────────────────
# Uncomment when switching providers
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5   # cheapest
# ANTHROPIC_MODEL=claude-opus-4-7    # most powerful

# ── JARVIS Personality ──────────────────────────────────────────────────────────
JARVIS_NAME=J.A.R.V.I.S
JARVIS_USER=Nivid
